{
  "$comment": "GENERATED by scripts/build-registry.mjs from data/. Do not edit by hand — edit the files under data/ and run `npm run build`. `npm run check` fails if this file drifts from them.",
  "workflow": {
    "$comment": "THE WORKFLOW IS DECLARED HERE AND NOWHERE ELSE. public/workflow.js executes this file and never names a stage or a transition of its own. Add a stage here and the engine, the module and the checks all follow. This is the same rule venue.css keeps for --tier.",
    "version": 1,
    "initial": "discovered",
    "stages": [
      {
        "id": "discovered",
        "label": "Discovered",
        "order": 0,
        "terminal": false,
        "committed": false,
        "note": "In the reference, not yet looked at."
      },
      {
        "id": "screening",
        "label": "Screening",
        "order": 1,
        "terminal": false,
        "committed": false,
        "note": "Reading the guidelines against the profile."
      },
      {
        "id": "eligible",
        "label": "Eligible",
        "order": 2,
        "terminal": false,
        "committed": false,
        "note": "Cleared eligibility; not yet started."
      },
      {
        "id": "drafting",
        "label": "Drafting",
        "order": 3,
        "terminal": false,
        "committed": true,
        "note": "Materials in progress."
      },
      {
        "id": "review",
        "label": "In review",
        "order": 4,
        "terminal": false,
        "committed": true,
        "note": "Draft complete, being read before submission."
      },
      {
        "id": "submitted",
        "label": "Submitted",
        "order": 5,
        "terminal": false,
        "committed": true,
        "note": "Sent. Nothing further to do but wait."
      },
      {
        "id": "decision",
        "label": "Awaiting decision",
        "order": 6,
        "terminal": false,
        "committed": true,
        "note": "Past the close date, outcome not yet known."
      },
      {
        "id": "awarded",
        "label": "Awarded",
        "order": 7,
        "terminal": true,
        "committed": true,
        "note": "Won."
      },
      {
        "id": "declined",
        "label": "Declined",
        "order": 8,
        "terminal": true,
        "committed": true,
        "note": "Not selected."
      },
      {
        "id": "ineligible",
        "label": "Ineligible",
        "order": 9,
        "terminal": true,
        "committed": false,
        "note": "Screened out on the guidelines."
      },
      {
        "id": "passed",
        "label": "Passed",
        "order": 10,
        "terminal": true,
        "committed": false,
        "note": "Eligible, deliberately not pursued this cycle."
      },
      {
        "id": "lapsed",
        "label": "Lapsed",
        "order": 11,
        "terminal": true,
        "committed": false,
        "note": "Close date went by without a submission. Applied by the engine, never by hand."
      }
    ],
    "transitions": [
      {
        "id": "screen",
        "from": [
          "discovered"
        ],
        "to": "screening",
        "mode": "manual",
        "label": "Screen"
      },
      {
        "id": "qualify",
        "from": [
          "screening"
        ],
        "to": "eligible",
        "mode": "manual",
        "label": "Mark eligible"
      },
      {
        "id": "disqualify",
        "from": [
          "screening"
        ],
        "to": "ineligible",
        "mode": "manual",
        "label": "Not eligible"
      },
      {
        "id": "start",
        "from": [
          "eligible"
        ],
        "to": "drafting",
        "mode": "manual",
        "label": "Start draft"
      },
      {
        "id": "ready",
        "from": [
          "drafting"
        ],
        "to": "review",
        "mode": "manual",
        "label": "Send to review"
      },
      {
        "id": "reopen",
        "from": [
          "review"
        ],
        "to": "drafting",
        "mode": "manual",
        "label": "Back to draft"
      },
      {
        "id": "submit",
        "from": [
          "review",
          "drafting"
        ],
        "to": "submitted",
        "mode": "manual",
        "label": "Mark submitted"
      },
      {
        "id": "pass",
        "from": [
          "discovered",
          "screening",
          "eligible",
          "drafting"
        ],
        "to": "passed",
        "mode": "manual",
        "label": "Pass this cycle"
      },
      {
        "id": "award",
        "from": [
          "decision",
          "submitted"
        ],
        "to": "awarded",
        "mode": "manual",
        "label": "Awarded"
      },
      {
        "id": "decline",
        "from": [
          "decision",
          "submitted"
        ],
        "to": "declined",
        "mode": "manual",
        "label": "Declined"
      },
      {
        "id": "close-out",
        "from": [
          "submitted"
        ],
        "to": "decision",
        "mode": "auto",
        "label": "Close date passed",
        "guard": {
          "all": [
            {
              "path": "derived.days",
              "op": "lt",
              "value": 0
            }
          ]
        }
      },
      {
        "id": "lapse",
        "from": [
          "discovered",
          "screening",
          "eligible",
          "drafting",
          "review"
        ],
        "to": "lapsed",
        "mode": "auto",
        "label": "Close date passed without submission",
        "guard": {
          "all": [
            {
              "path": "derived.days",
              "op": "lt",
              "value": 0
            }
          ]
        }
      }
    ],
    "guards": {
      "$comment": "Structured predicates, not strings. There is no expression parser and no eval() in this repository: the engine walks these objects directly. Supported ops are listed here and asserted by scripts/check-registry.mjs.",
      "ops": [
        "eq",
        "ne",
        "lt",
        "lte",
        "gt",
        "gte",
        "in",
        "truthy",
        "falsy"
      ],
      "combinators": [
        "all",
        "any",
        "not"
      ],
      "paths": "Dotted reads against { call, derived }. A path that does not resolve reads as undefined and fails every op except falsy."
    }
  },
  "vantage": {
    "$comment": "CONFIGURATION INPUT FOR THE SINGULAR VANTAGE MODULE. One module, no tabs. Everything the module shows — which signals appear, at which screen sizes, on which line of the card, in what order, in what colour — is declared here. public/fellowships/vantage.js names no field, no band and no colour of its own; it reads this file and renders whatever it finds. Change this file and the interface re-forms with no code change. Same rule venue.css keeps for --tier, moved up a level.",
    "$ritual": "These are the ranking inputs for the re-survey ritual. A scheduled re-survey rewrites data/open-calls/ and may retune the weights and bands below; neither touches the page. Nothing here is hardcoded in markup.",
    "module": {
      "id": "vantage",
      "title": "Vantage",
      "lede": "Every open call in the reference on one surface, grouped by how long is left and ranked by what it returns for the effort it costs."
    },
    "horizon_days": 420,
    "$bands_comment": "Deadline foresight is the primary lens. The horizon is 7 / 30 / 90 days, then everything beyond it. Two bands sit outside the horizon entirely: a call whose date has passed, and a call that has no sourced date at all — the second is the reference telling you what work it still owes.",
    "bands": [
      {
        "id": "week",
        "label": "Within 7 days",
        "max_days": 7,
        "hue": 8,
        "chroma": 0.16
      },
      {
        "id": "month",
        "label": "Within 30 days",
        "max_days": 30,
        "hue": 46,
        "chroma": 0.14
      },
      {
        "id": "quarter",
        "label": "Within 90 days",
        "max_days": 90,
        "hue": 268,
        "chroma": 0.13
      },
      {
        "id": "beyond",
        "label": "Beyond 90 days",
        "max_days": null,
        "hue": 232,
        "chroma": 0.07
      },
      {
        "id": "closed",
        "label": "Closed",
        "max_days": null,
        "hue": 0,
        "chroma": 0,
        "when_past": true
      },
      {
        "id": "undated",
        "label": "No sourced date",
        "max_days": null,
        "hue": 150,
        "chroma": 0.05,
        "when_undated": true
      }
    ],
    "$rank_comment": "Return on effort. Within each horizon band the top of the list is the best return for the effort it costs: award value and eligibility fit weighed against effort to submit. An award figure nobody has sourced scores at `unknown_award` rather than zero, so a missing figure neither flatters nor punishes a call — and the card marks it as missing either way.",
    "rank": {
      "effort_cost": {
        "low": 1,
        "medium": 1.6,
        "high": 2.4
      },
      "award_value": [
        {
          "up_to": 10000,
          "value": 0.35
        },
        {
          "up_to": 50000,
          "value": 0.7
        },
        {
          "up_to": null,
          "value": 1
        }
      ],
      "unknown_award": 0.5,
      "weights": {
        "award": 2,
        "fit": 3
      }
    },
    "order": [
      {
        "key": "derived.band_order",
        "dir": "asc"
      },
      {
        "key": "derived.ret",
        "dir": "desc"
      },
      {
        "key": "derived.days",
        "dir": "asc"
      }
    ],
    "profile": {
      "$comment": "What eligibility fit is scored against. Preferences only — disciplines, regions, career stage, appetite for effort. No name, no institution, no identifier, and nothing that could identify a student or any other individual belongs here or anywhere else in this repository. Nothing in it is transmitted anywhere.",
      "disciplines": [
        "film",
        "technology",
        "writing"
      ],
      "geography": [
        "US"
      ],
      "career_stage": [
        "emerging"
      ],
      "effort_tolerance": [
        "low",
        "medium"
      ]
    },
    "fit": {
      "$comment": "Each criterion names a key on the profile above and a key on the record, so the module can score fit without knowing what any of them mean. Add a criterion here and it is scored; the meter re-weights itself. \"any\" on either side is a wildcard.",
      "criteria": [
        {
          "id": "discipline",
          "profile": "disciplines",
          "call": "disciplines",
          "weight": 3
        },
        {
          "id": "geography",
          "profile": "geography",
          "call": "geography",
          "weight": 2
        },
        {
          "id": "career stage",
          "profile": "career_stage",
          "call": "career_stage",
          "weight": 2
        },
        {
          "id": "effort",
          "profile": "effort_tolerance",
          "call": "effort",
          "weight": 1
        }
      ]
    },
    "$fields_comment": "Each field declares WHAT it shows (from), WHAT KIND of thing it is (role), WHICH floors get it (tiers) and WHICH line of the card it sits on (line). Line grouping is configuration, not layout code: the module builds one row per distinct line value, in the order the values first appear here. Move a field to another line and the card re-forms.",
    "fields": [
