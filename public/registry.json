        "line": "signals",
        "tiers": [
          "phone",
          "pad",
          "desk"
        ]
      },
      {
        "id": "stage",
        "role": "stage",
        "from": "derived.stage_label",
        "line": "signals",
        "tiers": [
          "phone",
          "pad",
          "desk"
        ]
      },
      {
        "id": "closes",
        "role": "date",
        "from": "call.closes",
        "line": "signals",
        "tiers": [
          "pad",
          "desk"
        ]
      },
      {
        "id": "kind",
        "role": "tag",
        "from": "call.kind",
        "line": "signals",
        "tiers": [
          "pad",
          "desk"
        ]
      },
      {
        "id": "fit",
        "role": "meter",
        "from": "derived.fit",
        "line": "signals",
        "tiers": [
          "pad",
          "desk"
        ],
        "label": "fit"
      },
      {
        "id": "effort",
        "role": "tag",
        "from": "call.effort",
        "line": "signals",
        "tiers": [
          "desk"
        ]
      },
      {
        "id": "cycle",
        "role": "tag",
        "from": "call.cycle",
        "line": "signals",
        "tiers": [
          "desk"
        ]
      },
      {
        "id": "summary",
        "role": "prose",
        "from": "call.summary",
        "line": "detail",
        "tiers": [
          "desk"
        ]
      },
      {
        "id": "basis",
        "role": "provenance",
        "from": "derived.provenance",
        "line": "foot",
        "tiers": [
          "watch",
          "phone",
