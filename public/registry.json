          "desk"
        ]
      },
      {
        "id": "source",
        "role": "link",
        "from": "call.url",
        "line": "foot",
        "tiers": [
          "phone",
          "pad",
          "desk"
        ],
        "label": "Guidelines"
      }
    ],
    "density": {
      "$comment": "How much of the surface survives at each floor. max_rows null means all of them. The module reads its floor from --tier, exactly as venue.js does; it never measures a width.",
      "watch": {
