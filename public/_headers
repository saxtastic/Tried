# Cloudflare Workers Static Assets reads this file at deploy time.
# The venue loads no third-party anything, so the policy can stay closed.
#
# One relaxation against the original default-src 'none': connect-src 'self'.
# The Vantage module reads /registry.json at runtime rather than having the
# reference baked into a script, so the data stays inspectable as data. It is a
# same-origin GET; no third-party request is opened by it, and the standing
# no-third-party constraint is intact.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/venue.css
  Cache-Control: public, max-age=3600

/venue.js
  Cache-Control: public, max-age=3600

/vantage.css
  Cache-Control: public, max-age=3600

/vantage.js
  Cache-Control: public, max-age=3600

/workflow.js
  Cache-Control: public, max-age=3600

# The reference itself. Short cache: a corrected deadline should reach a reader
# quickly, and the file is small.
/registry.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

/app.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
