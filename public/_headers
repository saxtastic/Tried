# Cloudflare Workers Static Assets reads this file at deploy time.
# The venue loads no third-party anything, so the policy can stay closed.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/venue.css
  Cache-Control: public, max-age=3600

/venue.js
  Cache-Control: public, max-age=3600

/app.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
