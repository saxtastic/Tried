{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayeyoty.co/record-book/schema/complaint.schema.json",
  "title": "Complaint entry",
  "description": "One documented injury and the disposition of the legal process, if any, that followed it. process.unpunished is derived at build time and must not appear in stored data.",
  "type": "object",
  "required": [
    "id",
    "title",
    "incident",
    "classification",
    "conduct",
    "finding",
    "offense",
    "harmed",
    "respondents",
    "process",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CL-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "incident": {
      "type": "object",
      "required": [
        "date",
        "place"
      ],
      "properties": {
        "date": {
          "type": "object",
          "required": [
            "start",
            "precision"
          ],
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string"
            },
            "precision": {
              "enum": [
                "day",
                "month",
                "year",
                "range",
                "era"
              ]
            }
          }
        },
        "place": {
          "type": "object",
          "properties": {
            "locality": {
              "type": "string"
            },
            "county": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        },
        "jurisdiction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "harmed": {
      "type": "object",
      "properties": {
        "persons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PR-[A-Z0-9-]+$"
          }
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "collective": {
          "type": "string"
        },
        "interstitial": {
          "type": "string",
          "description": "Harm that falls between the recorded events and is counted nowhere: displacement, exile, abandoned property, suppressed testimony, severed kinship, continuing effects on people who were never present at the event."
        }
      }
    },
    "respondents": {
      "type": "object",
      "required": [
        "described"
      ],
      "properties": {
        "described": {
          "type": "string"
        },
        "named_in_sources": {
          "type": "boolean"
        },
        "official_capacity": {
          "type": "boolean",
          "description": "True where a respondent acted under colour of law. See METHODOLOGY.md section 8."
        }
      }
    },
    "process": {
      "type": "object",
      "required": [
        "outcome",
        "narrative"
      ],
      "properties": {
        "forum": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "enum": [
            "no_process",
            "investigated_no_charge",
            "charged_acquitted",
            "convictions_vacated",
            "convicted",
            "civil_settlement",
            "legislative_remedy",
            "posthumous_exoneration",
            "unresolved"
          ]
        },
        "narrative": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "unpunished"
        ]
      }
    },
    "impediments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^IMP-[A-Z0-9-]+$"
      }
    },
    "remedy": {
      "type": "object",
      "properties": {
        "sought": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "granted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outstanding": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "verification": {
      "enum": [
        "documented",
        "contested",
        "unverified"
      ]
    },
    "status_note": {
      "type": "string"
    },
    "finding": {
      "type": "object",
      "description": "The act and the actor are independent questions, and both are independent of what a forum did. An act may be established while no actor is identified and no process ever opened; that is the ordinary case in this book, not an inconsistency.",
      "required": [
        "act",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "act": {
          "enum": [
            "established",
            "contested",
            "unestablished"
          ],
          "description": "Did the violence occur? Answered by physical evidence, death records, ruins, and contemporaneous account - not by a forum, and not by this book's opinion."
        },
        "attribution": {
          "enum": [
            "named_in_sources",
            "described_unidentified",
            "unattributed",
            "contested"
          ],
          "description": "Who did it? A separate and usually harder question. Never inferred from the act."
        }
      }
    },
    "offense": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The offences the conduct constitutes on its face. A characterisation of conduct, never a verdict on a person: naming an offence is not naming an offender, which is what finding.attribution is for. May be empty only with offense_note."
    },
    "offense_note": {
      "type": "string",
      "description": "Required when offense is empty: why no offence is named."
    },
    "conduct": {
      "type": "string",
      "description": "What was done. Stated as conduct, not as an allegation: whether it occurred is finding.act, and whether anyone answered for it is process.outcome."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "const": "documented"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "minItems": 1
          }
        },
        "required": [
          "sources"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "const": "contested"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "required": [
          "status_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "const": "unverified"
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "sources": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "offense": {
            "maxItems": 0
          }
        },
        "required": [
          "offense"
        ]
      },
      "then": {
        "required": [
          "offense_note"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "finding": {
            "properties": {
              "act": {
                "const": "established"
              }
            },
            "required": [
              "act"
            ]
          }
        },
        "required": [
          "finding"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "not": {
              "const": "unverified"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "count": {
      "type": "object",
      "properties": {
        "documented": {
          "type": [
            "integer",
            "null"
          ]
        },
        "estimated_low": {
          "type": "integer"
        },
        "estimated_high": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "collective_note": {
          "type": "string"
        }
      }
    }
  }
}
